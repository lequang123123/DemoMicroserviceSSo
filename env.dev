# Environment Configuration
STAGE=dev
REGION=us-east-1
VERSION=1.0.0

# AWS Configuration
AWS_PROFILE=default
AWS_REGION=us-east-1

# Cognito Configuration
USER_POOL_ID=us-east-1_uWdqvDO9n
USER_POOL_CLIENT_ID=h1098nsapivi7j0nn3imjm4i5

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Feature Flags
ENABLE_WARMUP=true
ENABLE_XRAY=false
ENABLE_ENHANCED_MONITORING=false

# Local Development
LOCAL_DYNAMODB_PORT=8000
LOCAL_LAMBDA_PORT=3000
LOCAL_API_PORT=3001

# Testing
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!

# Monitoring
CLOUDWATCH_LOG_GROUP=/aws/lambda/microservice-sso
CLOUDWATCH_LOG_RETENTION_DAYS=7

# Security
HASH_SALT_ROUNDS=10

# Database
DB_CONNECTION_TIMEOUT=5000
DB_MAX_RETRIES=3

# Cache
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# CORS Configuration
CORS_ORIGIN=*
CORS_HEADERS=Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# JWT Configuration
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d 