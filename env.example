# Environment Configuration
STAGE=dev
REGION=us-east-1
VERSION=1.0.0

# AWS Configuration
AWS_PROFILE=default
AWS_REGION=us-east-1

# Cognito Configuration
USER_POOL_ID=your-user-pool-id
USER_POOL_CLIENT_ID=your-client-id
COGNITO_DOMAIN=your-cognito-domain

# DynamoDB Configuration
USERS_TABLE_NAME=microservice-sso-dev-users
ORDERS_TABLE_NAME=microservice-sso-dev-orders
PRODUCTS_TABLE_NAME=microservice-sso-dev-products
SESSIONS_TABLE_NAME=microservice-sso-dev-sessions

# Lambda Configuration
USER_SERVICE_ARN=your-user-service-arn
ORDER_SERVICE_ARN=your-order-service-arn
PRODUCT_SERVICE_ARN=your-product-service-arn
AUTH_SERVICE_ARN=your-auth-service-arn
COGNITO_AUTHORIZER_ARN=your-cognito-authorizer-arn

# API Gateway Configuration
API_GATEWAY_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev
API_GATEWAY_DOMAIN=your-api-domain.com

# CORS Configuration
CORS_ORIGIN=*
CORS_HEADERS=Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Email Configuration (for SES if needed)
SES_FROM_EMAIL=noreply@yourdomain.com
SES_REPLY_TO_EMAIL=support@yourdomain.com

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Feature Flags
ENABLE_WARMUP=true
ENABLE_XRAY=false
ENABLE_ENHANCED_MONITORING=false

# Local Development
LOCAL_DYNAMODB_PORT=8000
LOCAL_LAMBDA_PORT=3000
LOCAL_API_PORT=3001

# Testing
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!

# Deployment
DEPLOYMENT_BUCKET=your-deployment-bucket
DEPLOYMENT_PREFIX=serverless-deployments

# Monitoring
CLOUDWATCH_LOG_GROUP=/aws/lambda/microservice-sso
CLOUDWATCH_LOG_RETENTION_DAYS=7

# Security
ENCRYPTION_KEY=your-encryption-key-here
HASH_SALT_ROUNDS=10

# Third-party Services
EXTERNAL_API_URL=https://api.external-service.com
EXTERNAL_API_KEY=your-external-api-key

# Database
DB_CONNECTION_TIMEOUT=5000
DB_MAX_RETRIES=3

# Cache
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Custom Domain
CUSTOM_DOMAIN=api.yourdomain.com
CERTIFICATE_ARN=your-certificate-arn

# Notification
SNS_TOPIC_ARN=your-sns-topic-arn
SQS_QUEUE_URL=your-sqs-queue-url 