{
  "name": "microservice-sso-auth-only",
  "version": "2.0.0",
  "description": "Auth & User Management focused microservice with OAuth2 and Cognito",
  "main": "index.js",
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "deploy:auth": "serverless deploy --config serverless-optimized.yml --stage dev",
    "deploy:auth:prod": "serverless deploy --config serverless-optimized.yml --stage prod",
    "remove": "serverless remove",
    "remove:dev": "serverless remove --stage dev",
    "remove:prod": "serverless remove --stage prod",
    "remove:auth": "serverless remove --config serverless-optimized.yml --stage dev",
    "logs": "serverless logs -f",
    "info": "serverless info",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "offline": "serverless offline",
    "dev": "serverless offline start",
    "print": "serverless print",
    "package": "serverless package",
    "invoke": "serverless invoke",
    "invoke:local": "serverless invoke local",
    "logs:tail": "serverless logs -f --tail",
    "validate": "serverless config validate",
    "install:auth": "npm install && cd lambda/auth-service && npm install && cd ../user-service && npm install && cd ../cognito-authorizer && npm install && cd ../health-check && npm install && cd ../..",
    "install:all": "npm install && cd lambda/auth-service && npm install && cd ../user-service && npm install && cd ../cognito-authorizer && npm install && cd ../health-check && npm install && cd ../..",
    "frontend": "node serve.js",
    "test:frontend": "node serve.js",
    "start": "node serve.js",
    "deploy:optimized": "serverless deploy --config serverless-optimized.yml",
    "deploy:minimal": "serverless deploy --config serverless-minimal.yml",
    "remove:optimized": "serverless remove --config serverless-optimized.yml",
    "remove:minimal": "serverless remove --config serverless-minimal.yml",
    "backup:cognito": "node backup-cognito.js backup us-east-1_8ML8938m2",
    "backup:config": "node backup-cognito.js config us-east-1_8ML8938m2",
    "restore:cognito": "node backup-cognito.js restore",
    "deploy:safe": "npm run backup:cognito && npm run backup:config && npm run deploy:auth"
  },
  "devDependencies": {
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.0",
    "serverless-plugin-warmup": "^8.3.0",
    "jest": "^29.7.0",
    "eslint": "^8.54.0"
  },
  "dependencies": {
    "aws-sdk": "^2.1400.0"
  },
  "keywords": [
    "aws",
    "serverless",
    "microservice",
    "auth",
    "user-management",
    "oauth2",
    "lambda",
    "api-gateway",
    "cognito",
    "dynamodb"
  ],
  "author": "Your Name",
  "license": "MIT"
} 