  "description": "Microservice SSO system with Serverless Framework",
  "main": "index.js",
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "remove:dev": "serverless remove --stage dev",
    "remove:prod": "serverless remove --stage prod",
    "logs": "serverless logs -f",
    "info": "serverless info",
    "test": "jest",
    "lint": "eslint .",
    "offline": "serverless offline",
    "dev": "serverless offline start",
    "print": "serverless print",
    "package": "serverless package",
    "invoke": "serverless invoke",
    "invoke:local": "serverless invoke local",
    "logs:tail": "serverless logs -f --tail",
    "validate": "serverless config validate",
